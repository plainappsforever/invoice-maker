  "scripts": {
    "doctor": "scripts/doctor.sh",
    "dev": "expo start --dev-client --port 8188",
    "ios": "scripts/native.sh ios",
    "android": "scripts/native.sh android",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "verify": "npm run typecheck && npm run lint && jest --silent",
    "test:e2e": "scripts/e2e.sh ios",
    "test:e2e:android": "scripts/e2e.sh android",
    "preview": "scripts/native.sh ios preview && scripts/native.sh android preview",
    "preview:eas": "eas build --profile preview --platform all"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/ios/",
      "/android/"
    ],
    "globalSetup": "<rootDir>/test/global-setup.js"
  },
  "private": true
